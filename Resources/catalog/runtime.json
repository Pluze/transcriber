{
  "engine": "whisper.cpp",
  "policyVersion": 2,
  "compatibleVersionContains": "1.9.1",
  "environment": {},
  "arguments": [
    "--model", "{model}",
    "--file", "{file}",
    "--language", "{language}",
    "--threads", "{threads}",
    "--processors", "1",
    "--flash-attn",
    "--beam-size", "5",
    "--best-of", "5",
    "--max-context", "0",
    "--output-txt",
    "--output-srt",
    "--output-json-full",
    "--output-file", "{output}"
  ]
}
